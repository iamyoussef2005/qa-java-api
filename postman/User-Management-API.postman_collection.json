	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User - Positive",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const uniqueId = Date.now();",
									"pm.environment.set(\"uniqueUserEmail\", \"postman_\" + uniqueId + \"@example.com\");",
									"pm.environment.set(\"uniqueUsername\", \"postman_\" + uniqueId);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response body contains valid user details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.username).to.eql(pm.environment.get(\"uniqueUsername\"));",
									"    pm.expect(jsonData.email).to.eql(pm.environment.get(\"uniqueUserEmail\"));",
									"    pm.expect(jsonData.role).to.eql(\"USER\");",
									"    pm.expect(jsonData.createdAt).to.not.be.null;",
									"    pm.expect(jsonData.password).to.be.undefined;",
									"    pm.environment.set(\"registeredUserId\", jsonData.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{uniqueUsername}}\",\n    \"email\": \"{{uniqueUserEmail}}\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user with dynamically generated credentials. Verifies 201 Created and saves user details."
					},
					"response": []
				},
				{
					"name": "Login User - Admin Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token returned and saved to environment\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
									"    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
									"    pm.expect(jsonData.expiresIn).to.be.above(0);",
									"    pm.expect(jsonData.user.email).to.eql(\"admin@example.com\");",
									"    pm.environment.set(\"authToken\", jsonData.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"AdminPass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticates default admin user and extracts Bearer JWT token into {{authToken}}."
					},
					"response": []
				}
			]
		},
