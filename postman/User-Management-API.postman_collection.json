									"pm.test(\"Error message indicates conflict\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.eql(\"Conflict\");",
									"    pm.expect(jsonData.message).to.include(\"Email is already registered\");",
									"});"
